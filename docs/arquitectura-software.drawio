        <mxCell id="redis" value="REDIS&#xa;Rate limiting del Gateway&#xa;Caché de catálogo y carrito&#xa;fallback a PostgreSQL / MongoDB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4f0df;strokeColor=#69855f;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#263322;" vertex="1" parent="1"><mxGeometry x="600" y="485" width="260" height="115" as="geometry"/></mxCell>
        <mxCell id="flows" value="FLUJOS DE NEGOCIO&#xa;1. Catálogo público: Frontend → Gateway → Catálogo → caché/DB&#xa;2. Login: Frontend → Gateway → Usuarios → DB → JWT&#xa;3. Pedido: Carrito → Catálogo (validación) → MongoDB (pedido)&#xa;4. Seguimiento: Frontend → Gateway → Carrito → MongoDB&#xa;5. Admin: cambios → servicio dueño → DB + evento de auditoría" style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#fff4d6;strokeColor=#c5a85c;fontSize=13;fontColor=#493d21;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="255" y="675" width="610" height="190" as="geometry"/></mxCell>

