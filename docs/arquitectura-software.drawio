        <mxCell id="caddy" value="CADDY&#xa;Proxy inverso&#xa;HTTP 80 · HTTPS 443 · ACME&#xa;/api/* → Gateway · web → Frontend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6e9d9;strokeColor=#b8754f;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#3d2b22;" vertex="1" parent="1"><mxGeometry x="255" y="65" width="250" height="105" as="geometry"/></mxCell>
        <mxCell id="web" value="FRONTEND&#xa;Next.js 16 · React 19&#xa;Tienda · carrito · pedidos&#xa;login · reseñas · panel Admin&#xa;API vía /api/v1 · token en localStorage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6e9d9;strokeColor=#b8754f;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#3d2b22;" vertex="1" parent="1"><mxGeometry x="255" y="230" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="gateway" value="API GATEWAY&#xa;Spring Cloud Gateway / WebFlux&#xa;/api/v1 · validación JWT · CORS&#xa;rate limiting con Redis&#xa;circuit breaker · fallback · retry GET&#xa;reescribe prefijo de carrito" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0c7a9;strokeColor=#8e4c32;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#3d2b22;" vertex="1" parent="1"><mxGeometry x="585" y="180" width="280" height="160" as="geometry"/></mxCell>

