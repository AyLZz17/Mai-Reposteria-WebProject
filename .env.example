# Copia este archivo como .env y cambia los valores de ejemplo.
# No subas el archivo .env real a Git.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-esta-contrasena-local
JWT_SECRET=cambia-por-un-secreto-aleatorio-de-al-menos-32-bytes

# Desarrollo local. Para producción usa un dominio público y un origen HTTPS.
SITE_ADDRESS=localhost
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Opcionales
DELIVERY_FEE_COP=0
CONTACT_EMAIL=
